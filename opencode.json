{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "tester": {
      "description": "Ejecuta pruebas de Next.js (Jest/Playwright) y comandos de build.",
      "permission": [
        { "action": "bash", "resource": "npm run dev", "effect": "allow" },
        { "action": "bash", "resource": "npm run build", "effect": "allow" },
        { "action": "bash", "resource": "npm run test*", "effect": "allow" },
        { "action": "bash", "resource": "npx playwright test*", "effect": "allow" },
        { "action": "bash", "resource": "*", "effect": "ask" }
      ]
    },
    "reviewer": {
      "description": "Revisa el código de Lila's Cakes asegurando que se sigan los lineamientos de la arquitectura local (Next.js App Router, Tailwind, i18n)."
    }
  },
  "instructions": ["AGENTS.md", "docs/PROJECT.md", "docs/TASKS.md"]
}